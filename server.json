{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.temporevenue/proposals",
  "title": "TempoRevenue",
  "description": "Turn a client conversation into a priced proposal draft and track whether clients open or accept it.",
  "version": "1.2.2",
  "websiteUrl": "https://temporevenue.com",
  "icons": [
    {
      "src": "https://app.temporevenue.com/connector/temporevenue-connector-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/TempoRevenue/mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@temporevenue/mcp",
      "version": "1.2.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TEMPOREVENUE_API_KEY",
          "description": "API key from https://app.temporevenue.com/en/integrations. Without it the server runs in demo mode.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.temporevenue.com/api/mcp"
    }
  ]
}
